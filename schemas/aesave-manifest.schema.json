{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "aesave"
    },
    "schemaVersion": {
      "const": 1
    },
    "resourceId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9-]{36}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "steam"
        },
        "platformGameId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,9}$"
        }
      },
      "required": [
        "platform",
        "platformGameId"
      ]
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "purpose": {
          "enum": [
            "pre_unlock",
            "branch_point",
            "chapter_start",
            "manual_checkpoint",
            "general_progress",
            "other"
          ]
        },
        "origin": {
          "enum": [
            "automatic",
            "manual",
            "external",
            "community"
          ]
        },
        "capturedAtUtc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "contentFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "title",
        "purpose",
        "origin",
        "capturedAtUtc",
        "contentFingerprint"
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameBuild": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "dlcIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,9}$"
          }
        },
        "saveSlot": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "accountPortability": {
          "enum": [
            "unknown",
            "portable",
            "bound"
          ]
        }
      },
      "required": [
        "gameBuild",
        "dlcIds",
        "saveSlot",
        "accountPortability"
      ]
    },
    "achievements": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "platformAchievementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "relation": {
            "enum": [
              "candidate",
              "reference"
            ]
          }
        },
        "required": [
          "platformAchievementId",
          "relation"
        ]
      }
    },
    "achievementTiming": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "achievementId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "capturedAtUtc": { "type": "string", "format": "date-time" },
          "unlockedAtUtc": { "type": "string", "format": "date-time" },
          "unlockTimeSource": { "enum": ["platform", "first_observed"] },
          "offsetMs": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
        },
        "required": ["achievementId", "capturedAtUtc", "unlockedAtUtc", "unlockTimeSource", "offsetMs"]
      }
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^root-(0|[1-9][0-9]*)$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "id",
          "label"
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^root-(0|[1-9][0-9]*)$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "root",
          "path",
          "size",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "resourceId",
    "game",
    "save",
    "compatibility",
    "achievements",
    "roots",
    "files"
  ]
}
